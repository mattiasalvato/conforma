---
import Layout from '../layouts/Layout.astro';
import { Lock, ArrowLeft, ArrowUpRight, ShieldCheck, Mail, CheckCircle2, AlertCircle } from 'lucide-astro';
---

<Layout title="Practice Tracker | Area Riservata - CONFORMA">
  <main class="min-h-screen bg-brand-dark text-white flex flex-col justify-between relative overflow-hidden">
    
    <!-- Bagliori di sfondo coerenti col brand -->
    <div class="absolute top-0 right-1/3 w-[500px] h-[500px] bg-brand-gold/[0.04] rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-10 w-[450px] h-[450px] bg-blue-500/[0.03] rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Header minimale della pagina -->
    <header class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex items-center justify-between relative z-10">
          <!-- Logo CONFORMA. (punto compatto e attaccato) -->
    <a href="/" class="flex flex-col group shrink-0">
      <span class="text-xl sm:text-2xl font-black uppercase font-sans text-white inline-flex items-baseline">
        <span class="tracking-[0.18em]">CONFORM</span><span class="tracking-normal">A</span><span class="text-brand-gold -ml-[1px] font-serif text-2xl sm:text-3xl font-black leading-none">.</span>
      </span>
      <span class="text-[8px] sm:text-[9px] tracking-[0.28em] text-slate-400 uppercase -mt-0.5">
        Real Estate Compliance
      </span>
    </a>

      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Torna al sito</span>
      </a>
    </header>

    <!-- Contenuto Centrale -->
    <section class="w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16 text-center relative z-10 flex flex-col items-center">
      
      <!-- Pill status badge -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-gold opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-gold"></span>
        </span>
        <span class="text-[11px] font-semibold tracking-widest text-slate-300 uppercase">
          Practice Tracker v2.0 • In Fase di Rilascio
        </span>
      </div>

      <!-- Icona lucchetto dorata -->
      <div class="w-14 h-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-brand-gold shadow-xl mb-8">
        <Lock class="w-6 h-6" />
      </div>

      <!-- Titolo Principale -->
      <h1 class="font-serif text-4xl sm:text-6xl font-normal tracking-tight text-white leading-[1.12] mb-6">
        L'ambiente riservato alle tue pratiche è <span class="text-brand-gold italic">in arrivo</span>.
      </h1>

      <p class="text-slate-300 text-sm sm:text-base font-normal max-w-xl mx-auto leading-relaxed mb-10">
        Stiamo finalizzando la nuova data room digitale conforme ai protocolli di sicurezza notarile per il monitoraggio in tempo reale dei titoli edilizi e delle asseverazioni urbanistiche.
      </p>

      <!-- Form Container con feedback dinamico -->
      <div class="w-full max-w-md bg-white/[0.02] border border-white/10 rounded-2xl p-2.5 shadow-2xl backdrop-blur-sm relative">
        <form id="waitlist-form" class="flex flex-col sm:flex-row gap-2">
          <div class="relative flex-1">
            <input 
              id="waitlist-email"
              type="email" 
              name="email"
              required 
              placeholder="Inserisci la tua email professionale..."
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-xs text-white placeholder:text-slate-500 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-all"
            />
          </div>
          <button 
            id="waitlist-submit"
            type="submit"
            class="inline-flex items-center justify-center gap-1.5 bg-brand-gold hover:bg-brand-gold-hover text-brand-dark font-bold text-xs uppercase tracking-wider py-3.5 px-6 rounded-xl transition-all shadow-md shrink-0 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="waitlist-btn-text">Notificami</span>
            <ArrowUpRight id="waitlist-btn-icon" class="w-3.5 h-3.5" />
          </button>
        </form>

        <!-- Stato di Successo -->
        <div id="waitlist-success" class="hidden py-4 px-3 flex items-center justify-center gap-2 text-emerald-400 text-xs font-semibold">
          <CheckCircle2 class="w-4 h-4 shrink-0" />
          <span>Richiesta registrata! Ti contatteremo al rilascio.</span>
        </div>

        <!-- Stato di Errore -->
        <div id="waitlist-error" class="hidden py-2 px-3 text-rose-400 text-xs font-medium text-center">
          Si è verificato un errore durante l'invio. Riprova tra poco.
        </div>
      </div>

      <!-- Micro-garanzie istituzionali sotto il form -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 text-left max-w-md w-full pt-6 border-t border-white/5">
        <div class="flex items-center gap-2 text-[11px] text-slate-400">
          <ShieldCheck class="w-4 h-4 text-brand-gold shrink-0" />
          <span>Accesso crittografato SSL 256-bit</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-slate-400">
          <Mail class="w-4 h-4 text-brand-gold shrink-0" />
          <span>Nessun invio commerciale superfluo</span>
        </div>
      </div>

    </section>

    <!-- Footer Minimale -->
    <footer class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center text-xs text-slate-500 relative z-10 border-t border-white/5">
      <p>© 2026 CONFORMA S.r.l. — The Real Estate Compliance</p>
    </footer>

  </main>
</Layout>

<script>
  // Incolla qui l'URL dell'applicazione web distribuita da Google Apps Script
  const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzjrLsr72OVlnuWIbGi7pQumzxeZyLJX55o1M_XHxEARl2-PtbZIGixlg3R92-WiJwFNQ/exec";

  function initWaitlistForm() {
    const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('waitlist-email') as HTMLInputElement | null;
    const submitBtn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('waitlist-btn-text');
    const btnIcon = document.getElementById('waitlist-btn-icon');
    const successBox = document.getElementById('waitlist-success');
    const errorBox = document.getElementById('waitlist-error');

    if (!form || !emailInput || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();

      if (!email) return;

      // Imposta stato di caricamento UI
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Invio in corso...";
      btnIcon?.classList.add('hidden');
      errorBox?.classList.add('hidden');

      try {
        await fetch(GOOGLE_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors', // Fondamentale per i redirect di Apps Script
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email }),
        });

        // Mostra messaggio di successo
        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
      } catch (err) {
        console.error("Errore salvataggio sheet:", err);
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Notificami";
        btnIcon?.classList.remove('hidden');
        errorBox?.classList.remove('hidden');
      }
    });
  }

  // Supporta sia primo caricamento che navigazioni client-side di Astro
  initWaitlistForm();
  document.addEventListener('astro:after-swap', initWaitlistForm);
</script>