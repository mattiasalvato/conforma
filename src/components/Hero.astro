---
import { ArrowUpRight, ShieldCheck, Clock, TrendingUp } from 'lucide-astro';

const pillars = [
  {
    icon: ShieldCheck,
    title: "Conformità garantita",
    desc: "Audit dello stato legittimo, verifiche urbanistiche e regolarizzazioni conformi alle normative vigenti."
  },
  {
    icon: Clock,
    title: "Processi trasparenti",
    desc: "Aggiornamenti in tempo reale sull'avanzamento dei fascicoli tramite cruscotto digitale riservato."
  },
  {
    icon: TrendingUp,
    title: "Valore all'immobile",
    desc: "Un immobile asseverato riduce i tempi di closing ed elimina il rischio di contenzioso al rogito."
  }
];
---

<section class="bg-white text-slate-900 pt-10 sm:pt-14 pb-20 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid Editoriale: Sinistra (Headline + CTA) / Destra (Tagline + Paragrafo) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-12 sm:mb-16">
      
      <!-- Colonna Sinistra -->
      <div class="lg:col-span-7">
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-normal tracking-tight text-slate-950 leading-[1.08] mb-8">
          La conformità <br class="hidden sm:inline" />
          che valorizza <br class="hidden sm:inline" />
          il tuo immobile<span class="text-brand-gold font-sans font-bold">.</span>
        </h1>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#servizi"
            class="inline-flex items-center gap-2.5 bg-brand-dark hover:bg-black text-white text-xs font-semibold uppercase tracking-wider py-4 px-7 rounded-xl transition-all duration-200 group shadow-sm hover:shadow-md"
          >
            <span>Scopri i Servizi</span>
            <ArrowUpRight class="w-4 h-4 text-slate-300 group-hover:text-brand-gold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
          </a>

          <a
            href="#practice-tracker"
            class="inline-flex items-center text-xs font-semibold uppercase tracking-wider text-slate-700 hover:text-slate-950 py-3 px-5 transition-colors"
          >
            Practice Tracker &rarr;
          </a>
        </div>
      </div>

      <!-- Colonna Destra (Micro-tagline in alto a dx + Paragrafo descrittivo) -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full pt-2 lg:pl-6">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400 mb-6 lg:mb-16 lg:text-right">
          Advisory & Due Diligence Tecnica
        </p>

        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
          Trasformiamo la complessità urbanistica e catastale in sicurezza contrattuale. Supportiamo venditori, acquirenti e portafogli istituzionali nell'azzeramento dei rischi prima del rogito notarile.
        </p>
      </div>

    </div>

    <!-- Grande Fotografia Panoramica con angoli arrotondati -->
    <div class="relative w-full aspect-[16/8] sm:aspect-[21/9] rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-100 shadow-md mb-16 sm:mb-20">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2000&auto=format&fit=crop"
        alt="Interior Architecture"
        class="w-full h-full object-cover object-center hover:scale-[1.02] transition-transform duration-700"
      />
    </div>

    <!-- 3 Colonne Features Sotto -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 pt-8 border-t border-slate-200">
      {pillars.map((item) => {
        const Icon = item.icon;
        return (
          <div class="flex flex-col justify-between group">
            <div>
              <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-800 mb-5 group-hover:border-brand-dark transition-colors">
                <Icon class="w-5 h-5" />
              </div>
              <h3 class="font-serif text-xl font-medium text-slate-950 mb-2">
                {item.title}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed font-sans">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>