---
import { ArrowUpRight, ShieldCheck, Clock, FileCheck } from 'lucide-astro';

const pillars = [
  {
    icon: Clock,
    title: "Sopralluogo in 24h",
    desc: "Uscita tecnica fissata entro 24 ore dalla presa in carico ed iter avviato nelle successive 48 ore."
  },
  {
    icon: FileCheck,
    title: "Rilascio Certificato RRE",
    desc: "Relazione di Regolarità Edilizia asseverata, indispensabile per la validità del rogito notarile."
  },
  {
    icon: ShieldCheck,
    title: "Partner per Agenzie",
    desc: "Convenzioni operative dedicate alle reti immobiliari per gestire l'intero portafoglio senza intoppi."
  }
];
---

<section class="bg-brand-dark text-white border-b border-white/10">
  
  <!-- Parte Superiore: Navy Profondo con Headline, Agenzie e Certificato RRE -->
  <div class="pt-12 sm:pt-16 pb-14 sm:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Colonna Sinistra -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 mb-6">
            <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
            <span class="text-[10px] sm:text-[11px] font-bold tracking-[0.2em] text-slate-300 uppercase">
              Partner Tecnico per Agenzie & Proprietà
            </span>
          </div>

          <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-normal tracking-tight text-white leading-[1.08] mb-6">
            La conformità <br class="hidden sm:inline" />
            che valorizza <br class="hidden sm:inline" />
            il tuo immobile<span class="text-brand-gold font-sans font-bold -ml-1">.</span>
          </h1>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#contatti"
              class="inline-flex items-center gap-2.5 bg-brand-gold hover:bg-brand-gold-hover text-brand-dark text-xs font-bold uppercase tracking-wider py-4 px-7 rounded-xl transition-all shadow-md group"
            >
              <span>Richiedi Certificato RRE</span>
              <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </a>

            <a
              href="#practice-tracker"
              class="inline-flex items-center text-xs font-semibold uppercase tracking-wider text-slate-300 hover:text-white py-3 px-5 transition-colors"
            >
              Practice Tracker &rarr;
            </a>
          </div>
        </div>

        <!-- Colonna Destra -->
        <div class="lg:col-span-5 flex flex-col justify-between h-full pt-2 lg:pl-6">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-6 lg:mb-14 lg:text-right">
            Certificazione RRE & Due Diligence
          </p>

          <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
            Supportiamo le agenzie immobiliari nella gestione tecnica dei portafogli in vendita: azzeriamo i tempi morti e garantiamo la conformità urbanistica e catastale prima del preliminare.
          </p>
        </div>

      </div>

    </div>
  </div>

  <!-- Foto Panoramica -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mb-12 relative z-10">
    <div class="relative w-full aspect-[16/8] sm:aspect-[21/9] rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-900 shadow-2xl border border-white/10">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2000&auto=format&fit=crop"
        alt="Interior Architecture"
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- Blocco Inferiore Bianco con 3 Features e Tempistiche 24h/48h -->
  <div class="bg-white text-slate-900 pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        {pillars.map((item) => {
          const Icon = item.icon;
          return (
            <div class="flex flex-col justify-between group">
              <div>
                <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-800 mb-5 group-hover:border-brand-dark transition-colors">
                  <Icon class="w-5 h-5 text-brand-gold" />
                </div>
                <h3 class="font-serif text-xl font-medium text-slate-950 mb-2">
                  {item.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed font-sans">
                  {item.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

</section>