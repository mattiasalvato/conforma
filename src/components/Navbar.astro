---
import { Menu, X, ArrowUpRight, Lock } from 'lucide-astro';
---

<header class="sticky top-0 z-40 bg-brand-dark/95 backdrop-blur-md border-b border-white/10 text-white w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo CONFORMA. -->
      <a href="/" class="flex flex-col group shrink-0">
        <span class="text-xl sm:text-2xl font-black uppercase font-sans text-white inline-flex items-baseline">
          <span class="tracking-[0.18em]">CONFORM</span><span class="tracking-normal">A</span><span class="text-brand-gold -ml-[1px] font-serif text-2xl sm:text-3xl font-black leading-none">.</span>
        </span>
        <span class="text-[8px] sm:text-[9px] tracking-[0.28em] text-slate-400 uppercase -mt-0.5">
          Real Estate Compliance
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-7 text-xs font-semibold uppercase tracking-wider text-slate-300">
        <a href="/#servizi" class="hover:text-white transition-colors">Servizi</a>
        <a href="/#perche-conforma" class="hover:text-white transition-colors">Perché CONFORMA</a>
        <a href="/#practice-tracker" class="hover:text-white transition-colors">Practice Tracker</a>
        <a href="/#contatti" class="hover:text-white transition-colors">Contatti</a>
      </nav>

      <!-- Desktop CTAs (Area Riservata + Richiedi Consulenza) -->
      <div class="hidden md:flex items-center gap-3 lg:gap-4">
        <a
          href="/area-riservata"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider text-slate-300 hover:text-white hover:bg-white/5 transition-all border border-transparent hover:border-white/10"
        >
          <Lock class="w-3.5 h-3.5 text-brand-gold" />
          <span>Area Riservata</span>
        </a>

        <a
          href="/#contatti"
          class="inline-flex items-center gap-2 bg-brand-gold hover:bg-brand-gold-hover text-brand-dark text-xs font-bold uppercase tracking-wider py-2.5 px-5 rounded-xl transition-all shadow-md group"
        >
          <span>Richiedi Consulenza</span>
          <ArrowUpRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
        </a>
      </div>

      <!-- Hamburger Button (Mobile) -->
      <button
        id="mobile-menu-open"
        type="button"
        class="md:hidden p-2 text-slate-300 hover:text-white rounded-lg focus:outline-none cursor-pointer"
        aria-label="Apri menu"
      >
        <Menu class="w-6 h-6" />
      </button>

    </div>
  </div>
</header>

<!-- Mobile Nav Overlay Fullscreen Full-Width -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-50 w-screen h-screen h-dvh bg-brand-dark flex flex-col justify-between p-6 sm:p-10 opacity-0 pointer-events-none transition-all duration-300 ease-in-out md:hidden overflow-y-auto"
>
  <!-- Top bar con Logo e Chiudi -->
  <div class="flex items-center justify-between w-full shrink-0">
    <a href="/" class="flex flex-col mobile-nav-link">
      <span class="text-2xl font-black uppercase font-sans text-white inline-flex items-baseline">
        <span class="tracking-[0.18em]">CONFORM</span><span class="tracking-normal">A</span><span class="text-brand-gold -ml-[1px] font-serif text-3xl font-black leading-none">.</span>
      </span>
      <span class="text-[9px] tracking-[0.28em] text-slate-400 uppercase -mt-0.5">
        Real Estate Compliance
      </span>
    </a>
    <button
      id="mobile-menu-close"
      type="button"
      class="p-2 text-slate-300 hover:text-white rounded-lg focus:outline-none cursor-pointer"
      aria-label="Chiudi menu"
    >
      <X class="w-7 h-7" />
    </button>
  </div>

  <!-- Voci di Menu Centrali -->
  <nav class="flex flex-col gap-6 my-auto text-left w-full py-4">
    <a
      href="/#servizi"
      class="mobile-nav-link font-serif text-3xl sm:text-4xl text-white hover:text-brand-gold transition-colors block"
    >
      Servizi & RRE
    </a>
    <a
      href="/#perche-conforma"
      class="mobile-nav-link font-serif text-3xl sm:text-4xl text-white hover:text-brand-gold transition-colors block"
    >
      Perché CONFORMA
    </a>
    <a
      href="/#practice-tracker"
      class="mobile-nav-link font-serif text-3xl sm:text-4xl text-white hover:text-brand-gold transition-colors block"
    >
      Practice Tracker
    </a>
    <a
      href="/#contatti"
      class="mobile-nav-link font-serif text-3xl sm:text-4xl text-white hover:text-brand-gold transition-colors block"
    >
      Contatti
    </a>
  </nav>

  <!-- Bottom CTAs e Footer Link -->
  <div class="pt-6 border-t border-white/10 space-y-3.5 w-full shrink-0">
    <!-- Pulsante Area Riservata Mobile -->
    <a
      href="/area-riservata"
      class="mobile-nav-link flex items-center justify-center gap-2 w-full bg-white/10 hover:bg-white/15 text-white border border-white/15 font-semibold text-xs uppercase tracking-wider py-3.5 rounded-xl transition-all"
    >
      <Lock class="w-4 h-4 text-brand-gold" />
      <span>Accedi all'Area Riservata</span>
    </a>

    <!-- Pulsante Primario Mobile -->
    <a
      href="/#contatti"
      class="mobile-nav-link flex items-center justify-center gap-2 w-full bg-brand-gold hover:bg-brand-gold-hover text-brand-dark font-bold text-xs uppercase tracking-wider py-4 rounded-xl shadow-lg transition-all"
    >
      <span>Richiedi Consulenza</span>
      <ArrowUpRight class="w-4 h-4" />
    </a>

    <div class="flex justify-between items-center text-[11px] text-slate-400 pt-2">
      <span>info@conformagroup.it</span>
      <div class="flex gap-4">
        <a href="/privacy-policy" class="hover:text-slate-200 mobile-nav-link">Privacy</a>
        <a href="/cookie-policy" class="hover:text-slate-200 mobile-nav-link">Cookie</a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function setupMobileMenu() {
      const openBtn = document.getElementById('mobile-menu-open');
      const closeBtn = document.getElementById('mobile-menu-close');
      const overlay = document.getElementById('mobile-menu-overlay');
      const links = document.querySelectorAll('.mobile-nav-link');

      if (!openBtn || !closeBtn || !overlay) return;

      const openMenu = () => {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        document.documentElement.classList.add('overflow-hidden');
        document.body.classList.add('overflow-hidden');
      };

      const closeMenu = () => {
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        overlay.classList.add('opacity-0', 'pointer-events-none');
        document.documentElement.classList.remove('overflow-hidden');
        document.body.classList.remove('overflow-hidden');
      };

      openBtn.onclick = openMenu;
      closeBtn.onclick = closeMenu;

      links.forEach((link) => {
        link.onclick = closeMenu;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMobileMenu);
    } else {
      setupMobileMenu();
    }
    document.addEventListener('astro:after-swap', setupMobileMenu);
  })();
</script>