---
import { Linkedin, Instagram, Mail } from 'lucide-astro';
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
---

<footer class="bg-brand-dark text-white pt-16 pb-8 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center group mb-4">
          <Image 
            src={logoImg} 
            alt="CONFORMA - Real Estate Compliance" 
            class="h-9 sm:h-11 w-auto object-contain transition-transform group-hover:opacity-95" 
            loading="lazy" 
          />
        </a>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          La prima società specializzata nella conformità e regolarità edilizia per agenzie e investitori. Trasparenza, certezza, valore.
        </p>
        <div class="flex gap-4 text-slate-400">
          <a href="#" class="hover:text-brand-gold transition-colors" aria-label="LinkedIn"><Linkedin class="w-4 h-4" /></a>
          <a href="#" class="hover:text-brand-gold transition-colors" aria-label="Instagram"><Instagram class="w-4 h-4" /></a>
          <a href="mailto:info@conformagroup.it" class="hover:text-brand-gold transition-colors" aria-label="Email"><Mail class="w-4 h-4" /></a>
        </div>
      </div>

      <!-- Azienda -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Azienda</h5>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/#perche-conforma" class="hover:text-white transition-colors">Chi siamo</a></li>
          <li><a href="/#perche-conforma" class="hover:text-white transition-colors">Metodo CONFORMA</a></li>
          <li><a href="/#practice-tracker" class="hover:text-white transition-colors">Practice Tracker</a></li>
          <li><a href="/#contatti" class="hover:text-white transition-colors">Convenzioni Partner</a></li>
        </ul>
      </div>

      <!-- Servizi -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Servizi</h5>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/#servizi" class="hover:text-white transition-colors">Certificato RRE & Conformità</a></li>
          <li><a href="/#servizi" class="hover:text-white transition-colors">Due Diligence Pre-Acquisto</a></li>
          <li><a href="/#servizi" class="hover:text-white transition-colors">Convenzione Reti Agenzie</a></li>
          <li><a href="/#servizi" class="hover:text-white transition-colors">Gestione Portafogli Immobiliari</a></li>
        </ul>
      </div>

      <!-- Risorse / Osservatorio -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Risorse</h5>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/#osservatorio" class="hover:text-white transition-colors">Osservatorio Normativo</a></li>
          <li><a href="/#osservatorio" class="hover:text-white transition-colors">Guida Decreto Salva Casa</a></li>
          <li><a href="/#osservatorio" class="hover:text-white transition-colors">Checklist Rogito Notarile</a></li>
          <li><a href="/#contatti" class="hover:text-white transition-colors">FAQ Tecniche</a></li>
        </ul>
      </div>

      <!-- Contatti -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Contatti</h5>
        <p class="text-xs text-slate-400 leading-relaxed mb-3">
          Viale Papiniano 48<br/>20123 Milano (MI)
        </p>
        <p class="text-xs text-slate-400 mb-1">02 12345678</p>
        <a href="mailto:info@conformagroup.it" class="text-xs text-slate-400 hover:text-brand-gold transition-colors">
          info@conformagroup.it
        </a>
      </div>

    </div>

    <!-- Bottom copyright & Policy Links -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-4">
      <p>© 2026 CONFORMA S.r.l. — P.IVA 12345678901 — Tutti i diritti riservati</p>
      <div class="flex gap-6">
        <a href="/privacy-policy" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="/cookie-policy" class="hover:text-slate-300 transition-colors">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>