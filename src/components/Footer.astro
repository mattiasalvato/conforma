---
import { Linkedin, Instagram, Mail } from 'lucide-astro';
---

<footer class="bg-brand-dark text-white pt-16 pb-8 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-1">
        <span class="text-xl font-bold tracking-[0.2em] uppercase text-white block mb-1">
          Conform<span class="text-brand-gold">a</span>.
        </span>
        <span class="text-[9px] tracking-[0.25em] text-slate-400 uppercase block mb-4">
          Real Estate Compliance
        </span>
        <p class="text-xs text-slate-400 leading-relaxed mb-6">
          La prima società italiana specializzata nella compliance immobiliare. Trasparenza. Competenza. Valore.
        </p>
        <div class="flex gap-4 text-slate-400">
          <a href="#" class="hover:text-brand-gold transition-colors"><Linkedin class="w-4 h-4" /></a>
          <a href="#" class="hover:text-brand-gold transition-colors"><Instagram class="w-4 h-4" /></a>
          <a href="#" class="hover:text-brand-gold transition-colors"><Mail class="w-4 h-4" /></a>
        </div>
      </div>

      <!-- Azienda -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Azienda</h5>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#" class="hover:text-white transition-colors">Chi siamo</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Metodo CONFORMA</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Lavora con noi</a></li>
          <li><a href="#" class="hover:text-white transition-colors">News</a></li>
        </ul>
      </div>

      <!-- Servizi -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Servizi</h5>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#" class="hover:text-white transition-colors">SELL</a></li>
          <li><a href="#" class="hover:text-white transition-colors">BUY</a></li>
          <li><a href="#" class="hover:text-white transition-colors">PORTFOLIO</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Property Passport</a></li>
        </ul>
      </div>

      <!-- Risorse -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Risorse</h5>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#" class="hover:text-white transition-colors">Guide e approfondimenti</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Normativa</a></li>
          <li><a href="#" class="hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Contatti -->
      <div>
        <h5 class="text-xs font-bold tracking-wider uppercase text-white mb-4">Contatti</h5>
        <p class="text-xs text-slate-400 leading-relaxed mb-3">
          Viale Papiniano 48<br/>20123 Milano (MI)
        </p>
        <p class="text-xs text-slate-400 mb-1">02 12345678</p>
        <p class="text-xs text-slate-400">info@conforma.it</p>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-4">
      <p>© 2024 CONFORMA S.r.l. — P.IVA 12345678901 — Tutti i diritti riservati</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-300 transition-colors">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>