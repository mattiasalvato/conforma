---
const pillars = [
  {
    stat: "100%",
    label: "Validazione Titoli",
    desc: "Verifica e allineamento dello stato legittimo dell'immobile ai sensi del D.P.R. 380/01 prima del preliminare."
  },
  {
    stat: "Audit",
    label: "Team Multidisciplinare",
    desc: "Ingegneri, architetti e legali specializzati in diritto immobiliare ed edilizia residenziale e commerciale."
  },
  {
    stat: "-35%",
    label: "Tempi al Rogito",
    desc: "Digitalizzazione dei documenti e reperimento rapido degli atti edilizi per eliminare ritardi notarili."
  },
  {
    stat: "Zero",
    label: "Rischio Contenzioso",
    desc: "Asseverazione tecnica integrata a tutela di venditore e acquirente contro vizi e difformità occulte."
  }
];

const partners = [
  "ENGEL & VÖLKERS",
  "RE/MAX",
  "COLDWELL BANKER",
  "KW KELLERWILLIAMS.",
  "SOTHEBY'S INT. REALTY",
  "BNP PARIBAS REAL ESTATE"
];
---

<section id="perche-noi" class="py-24 bg-white border-b border-slate-200 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Intestazione Istituzionale -->
    <div class="max-w-2xl mb-16">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
        <p class="text-xs font-bold tracking-[0.25em] text-slate-400 uppercase">
          Perché scegliere CONFORMA
        </p>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal tracking-tight text-slate-950">
        Standard rigorosi per la tutela e la certezza delle transazioni.
      </h2>
    </div>

    <!-- 4 Colonne Metriche & Metodo -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pb-20 border-slate-200">
      {pillars.map((item) => (
        <div class="flex flex-col justify-between pt-4 border-t border-slate-200 group hover:border-slate-900 transition-colors">
          <div>
            <div class="font-serif text-3xl sm:text-4xl font-normal text-slate-950 tracking-tight mb-2">
              {item.stat}
            </div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-brand-dark mb-2">
              {item.label}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed font-sans">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>

  
</section>

<style>
  .marquee-track {
    animation: scrollMarquee 26s linear infinite;
  }

  @keyframes scrollMarquee {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      justify-content: center;
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>